{
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/server.ts"
    },
    {
      "src": "/health",
      "dest": "src/server.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/daily-alerts",
      "schedule": "0 22 * * 1-5"
    }
  ]
}
