# Copy to .env.local for local dev (or run `vercel env pull .env.local`). Never commit real values.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Direct (unpooled) URL from the Vercel ↔ Neon integration; `npm run migrate` prefers it for DDL.
DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
FINNHUB_API_KEY=
TIINGO_API_KEY=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Plan 06: daily ladder alerts (set these for Production AND Preview, or Preview deploys fail fast)
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
CRON_SECRET=
# APNs .p8 key: raw PEM, PEM with literal \n, or base64 of the PEM
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=5WDN96EM72
APNS_TOPIC=com.chenkai.wait
